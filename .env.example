# Generate with:  openssl rand -hex 24
API_TOKEN=change-me
# Starting value; can be changed later in the dashboard's settings
MONTHLY_BUDGET=1500
TZ_NAME=America/Vancouver
DB_PATH=/data/spend.db
RULES_PATH=/data/categories.json

# Optional: auto-categorize new merchants with Claude (billed to your API account, ~1 cent/month)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Foreign purchases are converted to HOME_CURRENCY at the day's rate plus your card's FX fee
HOME_CURRENCY=CAD
FX_FEE_PCT=2.5

# Optional: OpenAI Decisions API for categories (preferred over Claude when set; ~$0.0001 per new merchant)
OPENAI_API_KEY=
# AI picks below this confidence are flagged for review
AI_REVIEW_BELOW=0.75

# Your own devices' Tailscale IPs that need no token (requires the 127.0.0.1 port binding)
TRUSTED_DEVICES=
